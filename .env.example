# Hermes AI v6 Environment Configuration
# Copy this file to .env and fill in actual values.
# NEVER commit .env to git!

# === Environment Mode ===
# One of: testnet, demo, mainnet
HERMES_ENV=testnet

# === Binance Testnet (Futures Sandbox) ===
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# === Binance Demo Trading ===
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# === Binance Mainnet (REAL MONEY) ===
BINANCE_MAINNET_API_KEY=
BINANCE_MAINNET_API_SECRET=

# === Database ===
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_USER=hermes
TIMESCALE_PASSWORD=
TIMESCALE_DB=hermes_data

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# === Telegram Alerts (optional) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json
